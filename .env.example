# --- Realtime (Pusher Channels) — required ---
# Create a free app at https://dashboard.pusher.com (Channels product).
# Works natively on Vercel serverless — no self-hosted socket server needed.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=eu
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# --- Shared game/room state (Upstash Redis) — required ---
# Serverless functions on Vercel don't share memory, so authoritative room
# state (deck, hands, turn, scores) lives here. Free tier at https://upstash.com
# You can also add this straight from the Vercel Marketplace (Upstash integration),
# which auto-fills these two vars for you.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Postgres (OPTIONAL — only used for persisted match history) ---
# If unset, history simply isn't recorded; live gameplay is unaffected.
# e.g. a free Neon/Supabase/Vercel Postgres connection string.
DATABASE_URL=
